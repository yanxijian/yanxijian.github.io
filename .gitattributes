# 默认按文本处理并统一检出为 LF（否则 Windows 上 core.autocrlf=true 时
# 工作区会变成 CRLF，撞上 repo-rules.json 里的 eol=lf 规则）
* text=auto eol=lf

*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.sh     text eol=lf
*.py     text eol=lf
LICENSE  text eol=lf
.gitattributes text eol=lf
.nojekyll      text eol=lf
.githooks/pre-commit text eol=lf
